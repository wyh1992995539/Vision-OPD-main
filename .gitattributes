# Keep tracked text evidence byte-stable across Windows and Linux checkouts.
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Large experiment artifacts and model/data files are hashed as raw bytes.
*.parquet binary
*.safetensors binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
